{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/access/:path*",
      "destination": "/api/access"
    },
    {
      "source": "/api/workplace-data/:path*",
      "destination": "/api/workplace-data"
    }
  ]
}
